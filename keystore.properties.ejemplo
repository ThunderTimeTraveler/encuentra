# Copia este archivo como keystore.properties (NO se sube al repo) y pon la
# ruta a encuentra-firma.keystore. Es la llave con la que se firmaron todas
# las versiones publicadas; con otra, el APK no se instala encima.
storeFile=firma/encuentra-firma.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
